# Copy to hoctap.toml (gitignored) and adjust. Every key is optional.
# Environment variables override this file: HOCTAP_DATA_DIR, HOCTAP_HOST,
# HOCTAP_PORT, HOCTAP_LOG_LEVEL, HOCTAP_FRONTEND_DIST, HOCTAP_SOURCE_DIR.
# HOCTAP_CONFIG points to a different config file. Secrets (ANTHROPIC_API_KEY,
# TTS keys) are read from the environment only; never put them here.

[server]
# Relative paths are resolved against this file's folder.
data_dir = "data"
# 127.0.0.1 (default) only accepts connections from this PC. For the tablet/LAN setup in
# docs/https-and-windows-setup.md, bind every interface instead:
# host = "0.0.0.0"
host = "127.0.0.1"
port = 8000
log_level = "INFO"
# frontend_dist = "frontend/dist"
# source_dir = "Sach_Arch"
# HTTPS on the LAN (Story 1.11, see docs/https-and-windows-setup.md). `serve` uses these
# only when data/certs/cert.pem and key.pem both exist (created by `hoctap certs`).
# tls_port = 8443
# tls_cert_dir = "data/certs"

[build]
# Extraction settings (HOCTAP_EXTRACTION_MODEL etc. override them). Pages are sent
# to Claude through the Claude Code CLI (`claude -p`), which must be on PATH.
# extraction_model = "claude-opus-5"
# verify_model = "claude-opus-5"    # the verify stage's second answer (default: extraction_model)
# claude_executable = "claude"
# extraction_concurrency = 3        # parallel `claude -p` calls
# extraction_timeout_seconds = 900  # per call
# extraction_max_budget_usd = 1.0   # --max-budget-usd per call
# render_long_edge = 2576           # page PNG long edge in pixels
# Pre-flight estimate (fixed per page, standard prices in USD per million tokens):
# price_input_per_mtok = 5.0
# price_output_per_mtok = 25.0
# estimate_input_tokens_per_page = 30000
# estimate_output_tokens_per_page = 10000
