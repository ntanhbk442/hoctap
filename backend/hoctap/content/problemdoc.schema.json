{
  "$defs": {
    "ChoiceOption": {
      "additionalProperties": false,
      "properties": {
        "option_key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,15}$",
          "title": "Option Key",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "image_key": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Key"
        }
      },
      "required": [
        "option_key"
      ],
      "title": "ChoiceOption",
      "type": "object"
    },
    "CompareEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "a row's slot_key",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,15}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "enum": [
            "<",
            ">",
            "="
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "CompareEntry",
      "type": "object"
    },
    "ComparePart": {
      "additionalProperties": false,
      "properties": {
        "part_key": {
          "description": "the book's own label (a, b, c) or p1, p2... in reading order",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,15}$",
          "title": "Part Key",
          "type": "string"
        },
        "type": {
          "description": "Problem Type: compare",
          "enum": [
            "compare"
          ],
          "title": "Type",
          "type": "string"
        },
        "prompt": {
          "description": "the Part's own text; may be empty",
          "title": "Prompt",
          "type": "string"
        },
        "image_keys": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,15}$",
            "type": "string"
          },
          "title": "Image Keys",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CompareRow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "hint": {
          "description": "one hint for the child; never contains the answer",
          "title": "Hint",
          "type": "string"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "description": "[{key, value}], one per row slot_key",
          "items": {
            "$ref": "#/$defs/CompareEntry"
          },
          "title": "Answer",
          "type": "array"
        }
      },
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "rows",
        "hint",
        "solution",
        "answer"
      ],
      "title": "ComparePart",
      "type": "object"
    },
    "CompareRow": {
