          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        },
        "rows": {
          "type": "integer",
          "description": "{maximum: 20, minimum: 1}"
        },
        "cols": {
          "type": "integer",
          "description": "{maximum: 20, minimum: 1}"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/GridCell"
            }
          },
          "minItems": 1
        },
        "hint": {
          "type": "string",
          "description": "one hint for the child; never contains the answer"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "type": "array",
          "description": "[{key, value}], one per empty cell r{i}c{j}",
          "items": {
            "$ref": "#/$defs/NumericEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "rows",
        "cols",
        "cells",
        "hint",
        "solution",
        "answer"
      ]
    },
    "Heading": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
