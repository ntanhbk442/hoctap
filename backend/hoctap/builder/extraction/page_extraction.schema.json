        "image_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        },
        "image_key": {
          "type": "string",
          "description": "the cropped Problem, shown as it is printed\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "hint": {
          "type": "string",
          "description": "one hint for the child; never contains the answer"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "type": "null",
          "description": "always null: the solution only\n\n{default: None}"
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "image_key",
        "hint",
        "solution"
      ]
    },
    "GridCell": {
      "type": "object",
      "properties": {
        "given": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the printed value; an empty cell is an Answer Slot keyed r{i}c{j} (0-based row i, column j)\n\n{default: None}"
        }
      },
      "additionalProperties": false
    },
    "GridFillPart": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
