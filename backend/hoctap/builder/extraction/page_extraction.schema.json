        },
        "title": {
          "type": "string",
          "description": "the heading's title text after the label; may be empty"
        },
        "y": {
          "type": "number",
          "description": "the top edge of the heading, normalised 0-1 on the page (0 = page top)\n\n{maximum: 1.0, minimum: 0.0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "y"
      ]
    },
