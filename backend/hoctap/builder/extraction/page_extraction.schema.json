{
  "$defs": {
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "option_key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "{default: None}"
        },
        "image_key": {
          "anyOf": [
            {
              "type": "string",
              "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
            },
            {
              "type": "null"
            }
          ],
          "description": "{default: None}"
        }
      },
      "additionalProperties": false,
      "required": [
        "option_key"
      ]
    },
    "CompareEntry": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "a row's slot_key\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "value": {
          "type": "string",
          "enum": [
            "<",
            ">",
            "="
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ]
    },
    "ComparePart": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
          "description": "the book's own label (a, b, c) or p1, p2... in reading order\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "type": {
          "type": "string",
          "enum": [
            "compare"
          ],
          "description": "Problem Type: compare"
        },
        "prompt": {
          "type": "string",
          "description": "the Part's own text; may be empty"
        },
        "image_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompareRow"
          },
          "minItems": 1
        },
        "hint": {
          "type": "string",
          "description": "one hint for the child; never contains the answer"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "type": "array",
          "description": "[{key, value}], one per row slot_key",
          "items": {
            "$ref": "#/$defs/CompareEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "rows",
        "hint",
        "solution",
        "answer"
      ]
    },
    "CompareRow": {
      "type": "object",
      "properties": {
        "slot_key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "slot_key",
        "left",
        "right"
      ]
    },
    "ConnectDotsPart": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
          "description": "the book's own label (a, b, c) or p1, p2... in reading order\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "type": {
          "type": "string",
          "enum": [
            "connect_dots"
          ],
          "description": "Problem Type: connect_dots"
        },
        "prompt": {
          "type": "string",
          "description": "the Part's own text; may be empty"
        },
        "image_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        },
        "image_key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "dots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dot"
          },
          "description": "{minItems: 2}"
        },
        "hint": {
          "type": "string",
          "description": "one hint for the child; never contains the answer"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "$ref": "#/$defs/SequenceAnswer"
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "image_key",
        "dots",
        "hint",
        "solution",
        "answer"
      ]
    },
    "CountEntry": {
      "type": "object",
      "description": "A count: a non-negative integer (count_image, dot_draw).",
      "properties": {
        "key": {
          "type": "string",
          "description": "a slot_key\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "value": {
          "type": "string",
          "description": "{pattern: ^(0|[1-9][0-9]*)$}"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ]
    },
    "CountImagePart": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
          "description": "the book's own label (a, b, c) or p1, p2... in reading order\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "type": {
          "type": "string",
          "enum": [
            "count_image"
          ],
          "description": "Problem Type: count_image"
        },
        "prompt": {
          "type": "string",
          "description": "the Part's own text; may be empty"
        },
        "image_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        },
        "image_key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LabeledSlot"
          },
          "minItems": 1
        },
        "hint": {
          "type": "string",
          "description": "one hint for the child; never contains the answer"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "type": "array",
          "description": "[{key, value}], one per slot_key",
          "items": {
            "$ref": "#/$defs/CountEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "image_key",
        "slots",
        "hint",
        "solution",
        "answer"
      ]
    },
    "Dot": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "description": "the printed number; the dots are exactly 1..N\n\n{minimum: 1}"
        },
        "x": {
          "type": "number",
          "description": "normalised 0-1 on the image (not the page)\n\n{maximum: 1.0, minimum: 0.0}"
        },
        "y": {
          "type": "number",
          "description": "normalised 0-1 on the image (not the page)\n\n{maximum: 1.0, minimum: 0.0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "n",
        "x",
        "y"
      ]
    },
    "DotBox": {
      "type": "object",
      "properties": {
        "slot_key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "label": {
          "type": "string",
          "description": "the printed number or text under the box"
        },
        "given": {
          "type": "integer",
          "description": "dots already printed in the box (for 'draw more')\n\n{default: 0, minimum: 0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "slot_key",
        "label"
      ]
    },
    "DotDrawPart": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
          "description": "the book's own label (a, b, c) or p1, p2... in reading order\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "type": {
          "type": "string",
          "enum": [
            "dot_draw"
          ],
          "description": "Problem Type: dot_draw"
        },
        "prompt": {
          "type": "string",
          "description": "the Part's own text; may be empty"
        },
        "image_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        },
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DotBox"
          },
          "minItems": 1
        },
        "hint": {
          "type": "string",
          "description": "one hint for the child; never contains the answer"
        },
        "solution": {
          "$ref": "#/$defs/Solution"
        },
        "answer": {
          "type": "array",
          "description": "[{key, value}], one per slot_key; value = total dots, given included",
          "items": {
            "$ref": "#/$defs/CountEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "prompt",
        "image_keys",
        "boxes",
        "hint",
        "solution",
        "answer"
      ]
    },
    "DraftImage": {
      "type": "object",
      "properties": {
        "image_key": {
          "type": "string",
          "description": "a short lowercase key, e.g. hinh-1, tranh-ga\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "on_next_page": {
          "type": "boolean",
          "description": "true only when the image is on the NEXT page (a continued problem)"
        },
        "bbox": {
          "type": "array",
          "description": "[x0, y0, x1, y1] normalised 0-1 on the page the image is on\n\n{maxItems: 4, minItems: 4}",
          "items": {
            "type": "number",
            "description": "{maximum: 1.0, minimum: 0.0}"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "image_key",
        "on_next_page",
        "bbox"
      ]
    },
    "FallbackPart": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
          "description": "the book's own label (a, b, c) or p1, p2... in reading order\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "type": {
          "type": "string",
          "enum": [
            "fallback"
