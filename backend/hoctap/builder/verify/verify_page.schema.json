{
  "$defs": {
    "CompareEntry": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "a row's slot_key\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "value": {
          "type": "string",
          "enum": [
            "<",
            ">",
            "="
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ]
    },
    "CompareSecond": {
      "type": "object",
      "properties": {
        "part_key": {
          "type": "string",
          "description": "the Part's part_key, exactly as given\n\n{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "unsure": {
          "type": "boolean",
          "description": "true when you cannot solve the Part with confidence (instead of guessing)\n\n{default: False}"
        },
        "type": {
          "type": "string",
          "enum": [
            "compare"
          ],
          "description": "the Part's type: compare"
        },
        "answer": {
          "type": "array",
          "description": "[{key, value}], one per row slot_key",
          "items": {
            "$ref": "#/$defs/CompareEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "part_key",
        "type",
        "answer"
      ]
    },
    "ConnectDotsSecond": {
