        "key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "value": {
          "type": "string",
          "description": "{maxLength: 100, minLength: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ]
    },
