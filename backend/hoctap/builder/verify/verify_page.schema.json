    "Region": {
      "type": "object",
      "properties": {
        "region_key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "bbox": {
          "type": "array",
          "description": "[x0, y0, x1, y1] normalised 0-1 on the image (not the page)\n\n{maxItems: 4, minItems: 4}",
          "items": {
            "type": "number",
            "description": "{maximum: 1.0, minimum: 0.0}"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "region_key",
        "bbox"
      ]
    },
    "SelectedAnswer": {
      "type": "object",
      "properties": {
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "selected"
      ]
    },
    "SequenceAnswer": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "array",
          "description": "the dot numbers in drawing order: 1..N",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "sequence"
      ]
    },
    "SpotDifferenceAnswer": {
      "type": "object",
      "properties": {
