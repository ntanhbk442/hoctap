    "NumericEntry": {
      "type": "object",
      "description": "One keyed answer value: `key` is a slot_key, empty node_key or empty cell `r{i}c{j}`.",
      "properties": {
        "key": {
          "type": "string",
          "description": "{pattern: ^[a-z0-9][a-z0-9_-]{0,15}$}"
        },
        "value": {
          "type": "string",
          "description": "{pattern: ^-?(0|[1-9][0-9]*)(,[0-9]+)?$}"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ]
    },
    "OrderAnswer": {
      "type": "object",
      "properties": {
