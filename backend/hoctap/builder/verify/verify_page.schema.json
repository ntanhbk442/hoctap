    "VerifyProblem": {
      "type": "object",
      "properties": {
        "problem_id": {
          "type": "string",
          "description": "the Problem's problem_id, exactly as given"
        },
        "parts": {
          "type": "array",
          "description": "one entry per Part of the Problem",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/NumberInputSecond"
              },
              {
                "$ref": "#/$defs/ExpressionInputSecond"
              },
              {
                "$ref": "#/$defs/CompareSecond"
              },
              {
                "$ref": "#/$defs/MultipleChoiceSecond"
              },
              {
                "$ref": "#/$defs/ImageSelectSecond"
              },
              {
                "$ref": "#/$defs/OrderSecond"
              },
              {
                "$ref": "#/$defs/NumberTreeSecond"
              },
              {
                "$ref": "#/$defs/GridFillSecond"
              },
              {
                "$ref": "#/$defs/MatchSecond"
              },
              {
                "$ref": "#/$defs/CountImageSecond"
              },
              {
                "$ref": "#/$defs/DotDrawSecond"
              },
              {
                "$ref": "#/$defs/ConnectDotsSecond"
              },
              {
                "$ref": "#/$defs/SpotDifferenceSecond"
              },
              {
                "$ref": "#/$defs/FallbackSecond"
              }
            ],
            "description": "{discriminator: {'mapping': {'compare': '#/$defs/CompareSecond', 'connect_dots': '#/$defs/ConnectDotsSecond', 'count_image': '#/$defs/CountImageSecond', 'dot_draw': '#/$defs/DotDrawSecond', 'expression_input': '#/$defs/ExpressionInputSecond', 'fallback': '#/$defs/FallbackSecond', 'grid_fill': '#/$defs/GridFillSecond', 'image_select': '#/$defs/ImageSelectSecond', 'match': '#/$defs/MatchSecond', 'multiple_choice': '#/$defs/MultipleChoiceSecond', 'number_input': '#/$defs/NumberInputSecond', 'number_tree': '#/$defs/NumberTreeSecond', 'order': '#/$defs/OrderSecond', 'spot_difference': '#/$defs/SpotDifferenceSecond'}, 'propertyName': 'type'}}"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "problem_id",
        "parts"
      ]
    }
  },
  "type": "object",
  "description": "The second answers for every Problem given for one page.",
  "properties": {
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerifyProblem"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "problems"
  ]
}
